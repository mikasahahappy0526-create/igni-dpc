<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/igni_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/igni_bg"
            android:title="@string/app_name"
            app:titleTextColor="@color/igni_text" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/igni_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/igni_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textColor="@color/igni_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/statusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/igni_text"
                    tools:text="有効（完全管理端末）" />

                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/hint_not_owner"
                    android:textColor="@color/igni_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReapply"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_reapply"
            android:textSize="16sp"
            app:backgroundTint="@color/igni_orange"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnhide"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_unhide"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/igni_outline" />

        <TextView
            android:id="@+id/currentVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="20dp"
            android:textColor="@color/igni_text"
            android:textSize="14sp"
            tools:text="現在のバージョン: 1.0.7 (8)" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckUpdate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:text="@string/btn_check_update"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/igni_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallUpdate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:enabled="false"
            android:text="@string/btn_install_update"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/igni_outline" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/update_status_idle"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/update_note"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/reapply_note"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/unhide_note"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hiddenCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:textColor="@color/igni_muted"
            android:textSize="14sp"
            tools:text="これまでに非表示にしたアプリ: 0 件" />

        <TextView
            android:id="@+id/screenTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/igni_muted"
            android:textSize="14sp"
            tools:text="画面オフタイムアウト: 1800000 ms" />

        <TextView
            android:id="@+id/cameraPackages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/igni_muted"
            android:textSize="13sp"
            tools:text="検出カメラ: com.android.camera2" />

        <TextView
            android:id="@+id/darkModeSdk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:textColor="@color/igni_muted"
            android:textSize="14sp"
            tools:text="Android SDK: 28" />

        <TextView
            android:id="@+id/darkModeApis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/igni_muted"
            android:textSize="13sp"
            tools:text="ダークAPI: …" />

        <TextView
            android:id="@+id/darkModeResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/igni_muted"
            android:textSize="13sp"
            tools:text="ダーク適用結果: success" />

        <TextView
            android:id="@+id/darkModeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/igni_orange"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="このOSでは…"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/lockTaskNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/lock_task_note"
            android:textColor="@color/igni_orange"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:text="@string/allowlist_title"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/allowlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/igni_muted"
            android:textSize="13sp"
            tools:text="com.android.settings\ncom.android.vending" />
    </LinearLayout>
</ScrollView>
