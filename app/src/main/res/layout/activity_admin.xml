<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/igni_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/igni_bg"
            android:title="@string/app_name"
            app:titleTextColor="@color/igni_text" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/igni_surface"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/igni_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_label"
                    android:textColor="@color/igni_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/statusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textColor="@color/igni_text"
                    tools:text="はい" />

                <!-- Hidden: long Device Owner explanation -->
                <TextView
                    android:id="@+id/hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:ignore="UnusedAttribute" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReapply"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="14dp"
            android:text="@string/btn_reapply"
            android:textSize="16sp"
            app:backgroundTint="@color/igni_orange"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnhide"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_unhide"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/igni_outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnPersonal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_return_personal"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:backgroundTint="@color/igni_bad"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/returnPersonalStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text=""
            android:textColor="@color/igni_muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/currentVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:textColor="@color/igni_text"
            android:textSize="14sp"
            tools:text="現在のバージョン: 1.0.63" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_update"
            android:textColor="@color/igni_text"
            android:textSize="16sp"
            app:cornerRadius="14dp"
            app:strokeColor="@color/igni_outline" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/update_status_idle"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        


        <!-- LINE: [ LINE ] [ Play ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallLine"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_install_line"
                android:textColor="@color/igni_text"
                android:textSize="16sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/igni_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallLinePlay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="@string/btn_install_line_play"
                android:textColor="@color/igni_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/lineInstallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/line_status_idle"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/lineDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/line_disclaimer"
            android:textColor="@color/igni_orange"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />



        <!-- Alive: [ アライブ ] [ 開く ] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstallAlive"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/btn_install_alive"
                android:textColor="@color/igni_text"
                android:textSize="16sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/igni_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenAlive"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="88dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:text="@string/btn_open_alive"
                android:textColor="@color/igni_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAliveAccessibility"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/btn_alive_accessibility"
                android:textColor="@color/igni_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAliveOverlay"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/btn_alive_overlay"
                android:textColor="@color/igni_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/aliveInstallStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/alive_status_idle"
            android:textColor="@color/igni_muted"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- Hidden diagnostics (kept for binding / optional debug) -->
        <TextView
            android:id="@+id/googleAppStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/chromeBrowserStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/homeLayoutStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hiddenCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/screenTimeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/audioStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cameraPackages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />






        <TextView
            android:id="@+id/lockTaskNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:text="@string/lock_task_note"
            android:textColor="@color/igni_orange"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Hidden allowlist block -->
        <TextView
            android:id="@+id/allowlistTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/allowlist_title"
            android:visibility="gone" />

        <TextView
            android:id="@+id/allowlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
